{application, mcl_search, [
    {description, "Web search over the live internet for realm members, backed by SearXNG"},
    {vsn, "0.1.0"},
    {registered, [mcl_search_sup]},
    {mod, {mcl_search_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Outbound HTTP to SearXNG, plain OTP (inets/httpc).
        inets,
        %% The responder's behaviour and the member gate's key id.
        macula,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om
    ]},
    %% No default searxng_url: config/sys.config.src sets it from SEARXNG_URL,
    %% and the service refuses to start without one.
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-search"}]}
]}.
