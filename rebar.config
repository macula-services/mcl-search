%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_search.
%%
%% Web search over the live internet for realm members, backed by SearXNG
%%
%% One procedure, mcl-search/web_search, proxied to a SearXNG instance. No
%% store: it keeps no record of what anyone searched.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% 0.26.6 is the current line.
    {mcl_om, "~> 0.26.6"},
    %% Declared directly because the responder implements macula_response and
    %% the member gate derives its key id with macula_node_keys.
    {macula, "~> 12.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {mcl_search, "0.1.0"}, [mcl_search, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]},
    %% test_live/ calls a real, running SearXNG over HTTP. Not a CI gate: a
    %% SearXNG blip, or a runner with none reachable, must not block a change.
    %% Run it against a real instance (SEARXNG_URL, default http://127.0.0.1:8888):
    %%   rebar3 as live_test eunit --dir test_live
    {live_test, [{extra_src_dirs, ["test_live"]}]}
]}.
